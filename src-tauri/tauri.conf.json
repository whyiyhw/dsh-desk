{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsh-desk",
  "version": "0.3.3",
  "identifier": "com.whyiyhw.dshdesk",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/whyiyhw/dsh-desk/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczMDNEQjM0QUVDRkE0RTEKUldUaHBNK3VOTnNEY3hYK3A1aWNKdHQwa3Ezc1RkTVVod3JycXJNYWhNSWZENWlTaWJsRlh6VmQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
